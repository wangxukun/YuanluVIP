# DATABASE_URL: PostgreSQL connection string for Prisma.
# Shared with the yuanlu project database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yuanlu"

# Afdian (爱发电) plan IDs — one per membership tier.
# Create plans in your afdian merchant backend and paste the plan_id values here.
VITE_AFDIAN_PLAN_ID_WEEKLY="your_weekly_plan_id"
VITE_AFDIAN_PLAN_ID_MONTHLY="your_monthly_plan_id"
VITE_AFDIAN_PLAN_ID_QUARTERLY="your_quarterly_plan_id"
VITE_AFDIAN_PLAN_ID_YEARLY="your_yearly_plan_id"
